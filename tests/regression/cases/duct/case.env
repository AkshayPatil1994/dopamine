# 32x16x16 duct (4 x 1 x 1): velocity inlet at x=0, fixed-pressure outlet at x=4, no-slip walls in z,
# periodic in y. Exercises the inlet/outlet BCs and the Dirichlet-pressure outlet terms of the
# projection (flux correction, velocity reconstruction, pressure anchoring).
GEO_SRC=examples/RayleighBernard/RB.geo
GEO_SED='s/^Nx = .*/Nx = 32;/;s/^Ny = .*/Ny = 16;/;s/^Nz = .*/Nz = 16;/;s/^Lx = .*/Lx = 4.0;/;s/^Ly = .*/Ly = 1.0;/'
