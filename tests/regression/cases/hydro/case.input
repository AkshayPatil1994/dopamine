! Regression case: hydrostatic column on a skewed box. Outlets z0 (p=1) and zL (p=0) balance the body
! force fz = -1, so the fluid must stay at rest (Umax stays at the first-stage startup value).
&dopamine_domain
  mesh_file = 'mesh.msh'
  mesh_type = 'gmsh'
/
&dopamine_numerics
  advection_scheme = 'CDS'
  time_integrator  = 'RK3W'
  use_sgs          = .false.
  dt               = 2.0e-3
  t_end            = 100.0
  nstep_max        = 20
  adapt_dt         = .false.
  cfl_max          = 0.5
  p_tol            = 1.0e-12
  p_max_iter       = 1000
  n_nonortho_corr  = 4
/
&dopamine_physics
  nu = 1.0e-2
  fz = -1.0
/
&dopamine_bc
  n_patches = 6
  patch_name(1) = 'x0'
  patch_type(1) = 'periodic'
  patch_name(2) = 'xL'
  patch_type(2) = 'periodic'
  patch_name(3) = 'y0'
  patch_type(3) = 'periodic'
  patch_name(4) = 'yL'
  patch_type(4) = 'periodic'
  patch_name(5) = 'z0'
  patch_type(5) = 'outlet'
  patch_p(5)    = 1.0
  patch_name(6) = 'zL'
  patch_type(6) = 'outlet'
  patch_p(6)    = 0.0
/
&dopamine_initial_condition
  ic_type = 'uniform'
  ic_uref = 0.0
/
&dopamine_output
  prefix         = 'case'
  write_interval = 100000
/
&dopamine_stats
  solver_stats_frequency = 10
/
