! GAMG pressure solver (explicit) variant of duct_exact: Regression case (cell_projection = EXACT): laminar duct with inlet/outlet, 32x16x16, 20 fixed steps.
&dopamine_domain
  mesh_file = 'mesh.msh'
  mesh_type = 'gmsh'
/
&dopamine_numerics
  pressure_solver = 'gamg'
  rhie_chow_dual = .false.
  pressure_min_cos_theta = 0.0
  cell_projection = 'EXACT'
  advection_scheme = 'CDS'
  time_integrator  = 'RK3W'
  use_sgs          = .false.
  dt               = 1.0e-2
  t_end            = 100.0
  nstep_max        = 20
  cfl_max          = 0.5
  adapt_dt         = .false.
  p_tol            = 1.0e-10
  p_max_iter       = 1000
/
&dopamine_physics
  nu = 1.0e-2
/
&dopamine_bc
  n_patches = 6
  patch_name(1) = 'bottom_wall'
  patch_type(1) = 'noSlip'
  patch_name(2) = 'top_wall'
  patch_type(2) = 'noSlip'
  patch_name(3) = 'periodic_x0'
  patch_type(3) = 'inlet'
  patch_U(3,1)  = 1.0
  patch_U(3,2)  = 0.0
  patch_U(3,3)  = 0.0
  patch_name(4) = 'periodic_xL'
  patch_type(4) = 'outlet'
  patch_p(4)    = 0.0
  patch_name(5) = 'periodic_y0'
  patch_type(5) = 'periodic'
  patch_name(6) = 'periodic_yL'
  patch_type(6) = 'periodic'
/
&dopamine_initial_condition
  ic_type = 'uniform'
  ic_uref = 1.0
  ic_lref = 0.0
  noise_level = 0.0
/
&dopamine_output
  prefix         = 'case'
  write_interval = 100000
/
&dopamine_stats
  solver_stats_frequency = 1
/
