! Regression case: Taylor-Green vortex, 32^3, 20 fixed steps.
&dopamine_domain
  mesh_file = 'mesh.msh'
  mesh_type = 'gmsh'
/
&dopamine_numerics
  rhie_chow_dual = .false.
  cell_projection = 'LS'
  pressure_min_cos_theta = 0.0
  advection_scheme = 'QUICK'
  time_integrator  = 'RK3W'
  use_sgs          = .false.
  dt               = 1.0e-2
  t_end            = 100.0
  nstep_max        = 20
  cfl_max          = 0.6
  adapt_dt         = .false.
  p_tol            = 1.0e-10
  p_max_iter       = 1000
/
&dopamine_physics
  nu = 6.25e-4
/
&dopamine_bc
  n_patches = 6
  patch_name(1) = 'periodic_x0'
  patch_type(1) = 'periodic'
  patch_name(2) = 'periodic_xL'
  patch_type(2) = 'periodic'
  patch_name(3) = 'periodic_y0'
  patch_type(3) = 'periodic'
  patch_name(4) = 'periodic_yL'
  patch_type(4) = 'periodic'
  patch_name(5) = 'periodic_z0'
  patch_type(5) = 'periodic'
  patch_name(6) = 'periodic_zL'
  patch_type(6) = 'periodic'
/
&dopamine_initial_condition
  ic_type = 'taylor_green'
  ic_uref = 1.0
  ic_lref = 1.0
/
&dopamine_output
  prefix         = 'case'
  write_interval = 100000
/
&dopamine_stats
  solver_stats_frequency = 1
/
