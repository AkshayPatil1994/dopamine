! Regression case: divergence-free synthetic-eddy inflow (default sem_type = 'dfsem') on the skewed 12^3 box. ablInlet at x0,
! outlet at xL, periodic y (the eddies are wrapped across the seam), slip z. CDS advection, so the result must be
! independent of the rank count: guards the periodic seam on the CDS path and across partition cuts.
&dopamine_domain
  mesh_file = 'mesh.msh'
  mesh_type = 'gmsh'
/
&dopamine_numerics
  rhie_chow_dual = .false.
  cell_projection = 'LS'
  pressure_min_cos_theta = 0.0
  advection_scheme = 'CDS'
  time_integrator  = 'RK3W'
  use_sgs          = .false.
  dt               = 5.0e-3
  t_end            = 100.0
  nstep_max        = 20
  adapt_dt         = .false.
  cfl_max          = 0.5
  p_tol            = 1.0e-12
  p_max_iter       = 1000
  n_nonortho_corr  = 3
/
&dopamine_physics
  nu = 1.0e-3
/
&dopamine_abl
  wall_model = 'none'
  u_ref = 1.0
  z_ref = 0.5
  z0_m  = 0.01
  wind_dir_deg = 270.0
  use_sem = .true.
  sem_type = 'dfsem'
  n_eddies = 300
  sem_sigma = 0.2
/
&dopamine_bc
  n_patches = 6
  patch_name(1) = 'x0'
  patch_type(1) = 'ablInlet'
  patch_name(2) = 'xL'
  patch_type(2) = 'outlet'
  patch_p(2)    = 0.0
  patch_name(3) = 'y0'
  patch_type(3) = 'periodic'
  patch_name(4) = 'yL'
  patch_type(4) = 'periodic'
  patch_name(5) = 'z0'
  patch_type(5) = 'slip'
  patch_name(6) = 'zL'
  patch_type(6) = 'slip'
/
&dopamine_initial_condition
  ic_type = 'uniform'
  ic_uref = 1.0
  noise_level = 0.0
/
&dopamine_output
  prefix         = 'case'
  write_interval = 100000
/
&dopamine_stats
  solver_stats_frequency = 5
/
