# 32x16x16 wall-bounded box (2pi x 2pi x 1) with a Taylor-Green initial field, as 'channel', but with the
# Germano-Lilly dynamic Smagorinsky model (test filter, halo exchanges of the packed fields).
GEO_SRC=examples/RayleighBernard/RB.geo
GEO_SED='s/^Nx = .*/Nx = 32;/;s/^Ny = .*/Ny = 16;/;s/^Nz = .*/Nz = 16;/;s/^Lx = .*/Lx = 6.283185307179586;/;s/^Ly = .*/Ly = 6.283185307179586;/'
