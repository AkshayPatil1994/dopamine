! Regression case: Rayleigh-Benard, 24x24x16, 20 fixed steps.
&dopamine_domain
  mesh_file = 'mesh.msh'
  mesh_type = 'gmsh'
/
&dopamine_numerics
  advection_scheme          = 'KEP'
  temperature_scheme        = 'VANLEER_TVD'
  time_integrator           = 'RK3W'
  dt                        = 5.0e-2
  t_end                     = 100.0
  nstep_max                 = 20
  cfl_max                   = 0.5
  adapt_dt                  = .false.
  p_tol                     = 1.0e-10
  p_max_iter                = 500
  pressure_solver           = 'boomeramg'
  gradient_scheme           = 'LEAST_SQUARES'
  use_rotational_projection = .true.
  use_sgs                   = .false.
/
&dopamine_physics
  nu         = 6.3246e-4
  alpha_T    = 6.3246e-4
  beta       = 1.0
  T_ref      = 0.5
  gz         = -1.0
  boussinesq = .true.
/
&dopamine_bc
  n_patches = 6
  patch_name(1) = 'bottom_wall'
  patch_type(1) = 'fixedTemperature'
  patch_T(1)    = 1.0
  patch_name(2) = 'top_wall'
  patch_type(2) = 'fixedTemperature'
  patch_T(2)    = 0.0
  patch_name(3) = 'periodic_x0'
  patch_type(3) = 'periodic'
  patch_name(4) = 'periodic_xL'
  patch_type(4) = 'periodic'
  patch_name(5) = 'periodic_y0'
  patch_type(5) = 'periodic'
  patch_name(6) = 'periodic_yL'
  patch_type(6) = 'periodic'
/
&dopamine_initial_condition
  ic_type = 'uniform'
  ic_uref = 1.0e-2
  ic_lref = 0.0
  noise_level = 0.0
  wall_normal_direction = 3
/
&dopamine_output
  prefix         = 'case'
  write_interval = 100000
/
&dopamine_stats
  solver_stats_frequency = 1
/
