! Single-GPU benchmark: periodic Taylor-Green box, LS projection, fixed dt, no SGS, no output.
&dopamine_domain
  mesh_file = '@MESH@'
  mesh_type = 'openfoam'
/
&dopamine_numerics
  rhie_chow_dual = .false.
  cell_projection = 'LS'
  advection_scheme = 'QUICK'
  time_integrator  = 'RK3W'
  use_sgs          = .false.
  dt               = @DT@
  t_end            = 1.0e6
  nstep_max        = @NSTEP@
  adapt_dt         = .false.
  p_tol            = 1.0e-8
  p_max_iter       = 200
/
&dopamine_physics
  nu = 6.25e-4
/
&dopamine_bc
  n_patches = 6
  patch_name(1) = 'x0'
  patch_type(1) = 'periodic'
  patch_name(2) = 'xL'
  patch_type(2) = 'periodic'
  patch_name(3) = 'y0'
  patch_type(3) = 'periodic'
  patch_name(4) = 'yL'
  patch_type(4) = 'periodic'
  patch_name(5) = 'z0'
  patch_type(5) = 'periodic'
  patch_name(6) = 'zL'
  patch_type(6) = 'periodic'
/
&dopamine_initial_condition
  ic_type = 'taylor_green'
  ic_uref = 1.0
  ic_lref = 1.0
/
&dopamine_output
  prefix         = 'bench'
  write_interval = 100000000
/
&dopamine_stats
  solver_stats_frequency = @FREQ@
/
