! dopamine namelist input: Taylor-Green vortex
! Periodic box [0, 2*pi]^3, Re = 1600 (nu = U0*L/Re, U0=1, L=2*pi/2*pi=1 wavenumber)
! Mesh: taylor_green.msh  (64^3 hex, generated by taylor_green.geo)

&dopamine_domain
  mesh_file = 'taylor_green.msh'
  mesh_type = 'gmsh'
/

&dopamine_numerics
  advection_scheme       = 'QUICK'	! Recommended baseline; alternatives: KEP, KOREN_TVD, VANLEER_TVD, CDS
  time_integrator        = 'RK3W'
  use_sgs          = .false.		! ILES: disable SGS for DNS comparison at Re=1600
  dt               = 3.305e-3	        ! 64^3 - dt = 3.305e-3 , 128^3 - dt=1.6525e-3
  t_end            = 20.0
  cfl_max          = 0.6
  adapt_dt         = .true.
  solver_stats_frequency = 10
  p_tol            = 1.0e-8
  p_max_iter       = 1000
/

&dopamine_physics
  nu         = 6.25e-4      ! Re = U0/nu = 1/6.25e-4 = 1600
  alpha_T    = 0.0
  beta       = 0.0
  T_ref      = 300.0
  Pr_t       = 0.85
  gx         = 0.0
  gy         = 0.0
  gz         = 0.0
  boussinesq = .false.
/

&dopamine_bc
  n_patches = 6

  patch_name(1) = 'periodic_x0'
  patch_type(1) = 'periodic'

  patch_name(2) = 'periodic_xL'
  patch_type(2) = 'periodic'

  patch_name(3) = 'periodic_y0'
  patch_type(3) = 'periodic'

  patch_name(4) = 'periodic_yL'
  patch_type(4) = 'periodic'

  patch_name(5) = 'periodic_z0'
  patch_type(5) = 'periodic'

  patch_name(6) = 'periodic_zL'
  patch_type(6) = 'periodic'
/

&dopamine_initial_condition
  ic_type      = 'taylor_green'
  ic_uref      = 1.0
  ic_lref      = 1.0  
/

&dopamine_output
  prefix         = 'tgv'
  write_interval = 1200
/
