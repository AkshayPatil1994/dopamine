// 8-block (2x2x2 octant) transfinite lid-driven cavity mesh.
// Unit cube: x,y in [0,1] (side walls), z in [0,1] (z=0 bottom wall, z=1 lid).
// Each octant grades fine->coarse from its two/three outer walls toward the
// domain center, using shared Lines/Surfaces so the mesh is fully conformal.

N  = 20;    // cells per half-length (wall -> center)
r  = 1.5;   // geometric growth ratio, fine at the wall

Point(1) = {0.0, 0.0, 0.0, 1.0};
Point(2) = {0.5, 0.0, 0.0, 1.0};
Point(3) = {1.0, 0.0, 0.0, 1.0};
Point(4) = {0.0, 0.5, 0.0, 1.0};
