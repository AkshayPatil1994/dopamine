! DOPAMINE input - temporal convergence study, RK3W (Wray low-storage RK3)
! Mesh and dt are substituted by run_temporal_convergence.sh.
! Uses a fixed N=32 hex mesh; spatial error ~O(dx^2) is constant across runs.
! Expected temporal convergence rate: 3rd order in dt.

&dopamine_domain
  mesh_file = '__MESH_FILE__'
  mesh_type = 'gmsh'
/

&dopamine_numerics
  advection_scheme       = 'KEP'
  time_scheme            = 'RK3W'
  dt                     = __DT__
  t_end                  = 0.5
  adapt_dt               = .false.
  solver_stats_frequency = 1
  p_tol                  = 1.0e-10
  p_max_iter             = 2000
/

&dopamine_physics
  nu         = 6.25e-4
  alpha_T    = 0.0
  beta       = 0.0
  T_ref      = 300.0
  Pr_t       = 0.85
  gx         = 0.0
  gy         = 0.0
  gz         = 0.0
  boussinesq = .false.
/

&dopamine_bc
  n_patches = 6

  patch_name(1) = 'periodic_x0'
  patch_type(1) = 'periodic'

  patch_name(2) = 'periodic_xL'
  patch_type(2) = 'periodic'

  patch_name(3) = 'periodic_y0'
  patch_type(3) = 'periodic'

  patch_name(4) = 'periodic_yL'
  patch_type(4) = 'periodic'

  patch_name(5) = 'periodic_z0'
  patch_type(5) = 'periodic'

  patch_name(6) = 'periodic_zL'
  patch_type(6) = 'periodic'
/

&dopamine_initial_condition
  ic_type = 'taylor_green'
  ic_uref = 1.0
  ic_lref = 1.0
/

&dopamine_output
  prefix         = '__PREFIX__'
  write_interval = 999999
/
