! DOPAMINE input - 3D Taylor-Green vortex convergence study.
! __MESH_FILE__, __DT__, __T_END__ and __NU__ are substituted by run_convergence.py.
!
! Plain central advection (second order, no upwind dissipation) and no SGS model, so the
! only discretisation errors are the ones being measured. Output prefix is relative and
! short on purpose: it is a character(32) and the run directory is the working directory.

&dopamine_domain
  mesh_file = '__MESH_FILE__'
  mesh_type = 'gmsh'
/

&dopamine_numerics
  advection_scheme = 'CENTRAL'
  time_integrator  = 'RK3W'
  use_sgs          = .false.
  dt               = __DT__
  t_end            = __T_END__
  adapt_dt         = .false.
  cfl_max          = 100.0      ! otherwise the solver clips dt even with adapt_dt off
  p_tol            = 1.0e-10
  p_max_iter       = 2000
/

&dopamine_physics
  nu         = __NU__
  alpha_T    = 0.0
  beta       = 0.0
  boussinesq = .false.
/

&dopamine_bc
  n_patches = 6
  patch_name(1) = 'periodic_x0'
  patch_type(1) = 'periodic'
  patch_name(2) = 'periodic_xL'
  patch_type(2) = 'periodic'
  patch_name(3) = 'periodic_y0'
  patch_type(3) = 'periodic'
  patch_name(4) = 'periodic_yL'
  patch_type(4) = 'periodic'
  patch_name(5) = 'periodic_z0'
  patch_type(5) = 'periodic'
  patch_name(6) = 'periodic_zL'
  patch_type(6) = 'periodic'
/

&dopamine_initial_condition
  ic_type = 'taylor_green'
  ic_uref = 1.0
  ic_lref = 1.0
/

&dopamine_output
  prefix         = 'tgv'
  write_interval = 999999
/

&dopamine_stats
  solver_stats_frequency = 1
/
