! 3D Spatial convergence test - Taylor-Green vortex decay
! This template is used to generate input files at different resolutions.
! Replace {NX} with desired grid resolution (16, 32, 64, 128, etc.)

&dopamine_domain
  ! gmsh mesh file (generated by generate_meshes.py)
  mesh_file = './mesh_{NX}x{NX}.msh'
  mesh_type = 'gmsh'
/

&dopamine_numerics
  ! RK3W temporal integration (Wray low-storage 3rd order)
  time_scheme = 'RK3W'

  ! CENTRAL advection (2nd order, low dissipation)
  advection_scheme = 'CENTRAL'

  ! Small timestep to minimize temporal error
  ! For spatial convergence, keep deltat << (deltax)^2/nu
  dt = 0.0001

  ! Run for short time to capture decay
  t_end = 0.001

  solver_stats_frequency = 1

  ! Pressure solver tolerance (tight to avoid pressure error)
  p_tol = 1.0e-9
  p_max_iter = 500

  ! CFL should be satisfied automatically
  cfl_max = 0.5
  adapt_dt = .false.

  ! Kinematic viscosity (Re = 200 for TG vortex)
  nu = 0.01

  ! No adaptive timestepping
  adapt_dt = .false.
/

&dopamine_physics
  ! Taylor-Green vortex decay
  nu = 0.01

  ! No gravity or forcing for this test
  f_const(1) = 0.0
  f_const(2) = 0.0
  f_const(3) = 0.0
/

&dopamine_initial_condition
  ! Manufactured: 3D Taylor-Green vortex
  ! Domain: [0, 2pi]^3 periodic
  ! Used to verify 2nd-order spatial accuracy of solver
  ic_type = 'taylor_green_vortex'
/

&dopamine_output
  prefix = 'convergence_tg_{NX}x{NX}'
  write_interval = 10
  hdf5_use_file_locking = .false.
/

&dopamine_checkpoint
  checkpoint_interval = 0
  restart_enabled = .false.
/
